{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/runtime-evolution-workbench/schemas/rew.pattern-registry.v1.schema.json",
  "title": "Runtime Evolution Workbench Pattern Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "generated_at", "product", "patterns"],
  "properties": {
    "schema_version": { "const": "rew.pattern-registry.v1" },
    "registry_id": { "type": "string", "pattern": "^pattern-registry:[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "product": { "$ref": "#/$defs/product" },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "runtime-evolution-workbench" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "source_kind", "source_id", "note", "created_at"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["support", "counterexample"] },
        "source_kind": { "enum": ["run", "issue", "comparison", "proposal", "external"] },
        "source_id": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "slug", "title", "summary", "scope", "status", "created_at", "updated_at", "evidence"],
      "properties": {
        "pattern_id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "confirmed", "contested", "retired"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
